// Schema for "Suivi des écarts" — reconstruit à partir de l'application Power Apps
// d'origine (Dossiers -> Écarts -> Fiches SSE -> Plan d'action).
//
// Différences volontaires par rapport aux tables Excel d'origine :
// - vrais types Date/Enum au lieu de tout stocker en texte (source du bug corrigé
//   précédemment sur le champ "Date" d'EcartAmiante_1) ;
// - référence humaine (ex. "EC-2026-0007") générée dans une transaction avec
//   verrou, pour éviter la collision d'ID possible dans le code Power Fx d'origine
//   (Max(...)+1 sans verrou).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  UTILISATEUR
}

enum Origine {
  REMONTEE_TERRAIN
  AUDIT_INTERNE
  AUDIT_EXTERNE
  VISITE_CHANTIER
  CONTROLE_TERRAIN
  RONDE_SECURITE
  INCIDENT_ACCIDENT
  AUTRE
}

enum StatutDossierEcart {
  A_QUALIFIER
  OUVERT
  EN_COURS
  CLOTURE
}

// Une réclamation se clôt quand le plaignant a reçu sa réponse et que les
// actions sont soldées : la fin des actions ne suffit pas.
enum StatutReclamation {
  OUVERTE
  EN_COURS
  CLOTUREE
}

enum TypeReclamation {
  RECLAMATION
  PLAINTE
}

enum OrigineRemontee {
  CHANTIER
  BUREAU
  AUDIT_BLANC
  AUDIT
}

enum StatutRemontee {
  A_TRAITER
  EN_COURS
  TRAITEE
  TRANSFORMEE_EN_ECART
}

enum TypeActivite {
  SS3_RETRAIT_ENCAPSULAGE
  SS4_INTERVENTION
  PREPARATION_CHANTIER
  REPLI_RESTITUTION
  GESTION_DECHETS
  MATERIEL
  ACTIVITE_SUPPORT
  AUTRE
}

enum StatutFiche {
  EN_COURS
  FINALISEE
}

enum TypeAction {
  CURATIVE
  CORRECTIVE
  PREVENTIVE
}

enum StatutAction {
  A_FAIRE
  EN_COURS
  EN_RETARD
  REALISEE
  ANNULEE
}

enum OrigineREX {
  REMONTEE
  EVENEMENT_SSE
  ECART_AMIANTE
  ECART_TERRAIN
  RECLAMATION
  // REX spontané ou bonne pratique : aucun écart, évènement ou remontée
  // source, capitalisé hors de toute non-conformité constatée.
  SPONTANE
  // Éléments récurrents de plusieurs types à la fois (écarts et évènements, par exemple).
  PLUSIEURS_SOURCES
}

enum StatutREX {
  REDIGE
  DIFFUSE
  EFFICACITE_VERIFIEE
}

// Ce que le REX tire de sa source, distinct de l'origine (d'où il vient).
// Pas de nature "Action à mettre en œuvre" distincte : dans la pratique, une
// telle action se confond toujours avec une évolution de méthode ou de
// document (EVOLUTION_METHODE), ce qui en faisait une nature redondante.
enum NatureREX {
  BONNE_PRATIQUE
  PRATIQUE_A_EVITER
  EVOLUTION_METHODE
}

model User {
  id           String   @id @default(cuid())
  // On se connecte avec son prénom, pas avec son adresse : le terrain n'a pas
  // toujours d'adresse professionnelle sous la main.
  identifiant  String   @unique
  // Conservé pour les comptes qui en ont un, mais ne sert plus à se connecter.
  email        String?
  name         String
  passwordHash String
  role         Role     @default(UTILISATEUR)
  createdAt    DateTime @default(now())
}

// Compteur de séquence par (type d'entité, année), utilisé pour générer les
// références humaines de façon atomique (SELECT ... FOR UPDATE).
model ReferenceCounter {
  entite String
  annee  Int
  valeur Int    @default(0)

  @@id([entite, annee])
}

model Dossier {
  id                String             @id @default(cuid())
  reference         String             @unique
  dateDetection     DateTime
  origine           Origine
  statut            StatutDossierEcart @default(OUVERT)
  declarant         String
  chantier          String
  // Enregistrement joint au dossier — photo ou PDF — stocké en data URL comme
  // la preuve des actions. Le nom d'origine est conservé à côté : un PDF ne
  // s'affiche pas en vignette, c'est son nom qui dit ce que c'est.
  enregistrement    String?
  enregistrementNom String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  modifiePar        String?
  modifieLe         DateTime?
  archiveLe         DateTime?
  ecarts            Ecart[]
}

model Ecart {
  id               String             @id @default(cuid())
  reference        String             @unique
  dossier          Dossier?           @relation(fields: [dossierId], references: [id])
  dossierId        String?
  dateDetection    DateTime
  origine          Origine
  statut           StatutDossierEcart @default(OUVERT)
  declarant        String
  typeActivite     TypeActivite?
  natures          String[]
  domaines         String[]
  gravite          String?
  frequence        String?
  criticite        String?
  theme            String[]           @default([])
  description      String?
  mesureImmediate  String?
  cause            String?
  ficheSSECreee    Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  modifiePar       String?
  modifieLe        DateTime?
  archiveLe        DateTime?
  fichesSSE        FicheSSE[]
  actions          Action[]
  remontees        RemonteeInfo[]     @relation("RemonteeEcarts")
  remonteesOrigine RemonteeInfo[]     @relation("RemonteeEcartOrigine")
  rex              Rex[]
}

// Remontée d'information : ce que le terrain ou le bureau fait remonter au
// quotidien. Beaucoup restent de simples informations traitées telles quelles ;
// certaines justifient l'ouverture d'un écart, auquel cas la remontée reste
// reliée à l'écart qu'elle a produit pour garder la traçabilité de l'origine.
model RemonteeInfo {
  id                String          @id @default(cuid())
  reference         String          @unique
  dateRemontee      DateTime
  origine           OrigineRemontee
  chantierService   String
  personneRemontant String?
  personneSaisie    String?
  objet             String
  natures           String[]        @default([])
  categories        String[]        @default([])
  description       String?
  suiteDonnee       String?
  statut            StatutRemontee  @default(A_TRAITER)
  // Rattachement : les constats auxquels cette remontée se rapporte. Plusieurs
  // écarts, car un même signalement en révèle souvent plus d'un ; ou un
  // évènement SSE ; jamais les deux types à la fois.
  ecarts            Ecart[]         @relation("RemonteeEcarts")
  ficheSSE          FicheSSE?       @relation(fields: [ficheSSEId], references: [id])
  ficheSSEId        String?
  // L'écart né de cette remontée, posé par « Transformer en écart ». Distinct
  // du rattachement : il désigne une filiation, pas un simple lien, et c'est
  // lui qui rend l'origine d'un écart traçable. Le statut
  // TRANSFORMEE_EN_ECART va toujours de pair avec lui.
  ecartOrigine      Ecart?          @relation("RemonteeEcartOrigine", fields: [ecartOrigineId], references: [id])
  ecartOrigineId    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  modifiePar        String?
  modifieLe         DateTime?
  archiveLe         DateTime?
  actions           Action[]
  rex               Rex[]

  // La fiche d'un évènement liste ses remontées : sans index, cette lecture
  // ferait un parcours complet de la table.
  @@index([ficheSSEId])
}

model FicheSSE {
  id                           String         @id @default(cuid())
  reference                    String         @unique
  ecart                        Ecart?         @relation(fields: [ecartId], references: [id])
  ecartId                      String?
  ecartAmiante                 EcartAmiante?  @relation(fields: [ecartAmianteId], references: [id])
  ecartAmianteId               String?
  reclamation                  Reclamation?   @relation(fields: [reclamationId], references: [id])
  reclamationId                String?
  typeEvenement                String?
  numeroInterne                String?
  statutFiche                  StatutFiche    @default(EN_COURS)
  emetteur                     String?
  nomChantier                  String?
  dateHeure                    DateTime?
  lieuZone                     String?
  personnesImpliquees          String?
  temoins                      String?
  declarationExterneNecessaire Boolean?
  declarationExterneA          String?
  descriptionFactuelle         String?
  gravite                      String?
  frequence                    String?
  criticite                    String?
  typeAnalyse                  String?
  toutesActionsCloturees       Boolean?
  miseAJourNecessaire          String[]       @default([])
  procedureLaquelle            String?
  referenceDUERP               String?
  miseAJourAutrePrecision      String?
  nouveauRisqueNecessaire      Boolean?
  referenceNouveauRisque       String?
  communicationInterne         Boolean?
  typeCommunication            String?
  validationNom                String?
  validationFonction           String?
  validationDate               DateTime?
  mesuresImmediatesPrises      String?
  dateEnvoi                    DateTime?
  domaine                      String[]       @default([])
  theme                        String[]       @default([])
  referencePreuve              String?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  modifiePar                   String?
  modifieLe                    DateTime?
  archiveLe                    DateTime?
  causes                       CauseArbre[]
  actions                      Action[]
  remontees                    RemonteeInfo[]
  rex                          Rex[]
}

// Arbre des causes d'une fiche SSE : hiérarchie de causes (auto-référencée),
// avec un marqueur de cause racine.
model CauseArbre {
  id             String       @id @default(cuid())
  ficheSSE       FicheSSE     @relation(fields: [ficheSSEId], references: [id])
  ficheSSEId     String
  parent         CauseArbre?  @relation("CauseArbreParent", fields: [parentId], references: [id])
  parentId       String?
  enfants        CauseArbre[] @relation("CauseArbreParent")
  libelle        String
  estCauseRacine Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// Suivi des écarts amiante — entité autonome, comme dans l'app d'origine
// (EcartAmiante_1 n'était pas rattachée à Dossier/Ecart, seulement, en option,
// à une Fiche SSE quand un événement SSE en découlait).
model EcartAmiante {
  id                             String             @id @default(cuid())
  reference                      String             @unique
  date                           DateTime
  nomChantier                    String
  numeroChantier                 String
  conducteur                     String
  chef                           String
  zone                           String?
  processus                      String?
  typeAnalyse                    String?
  referenceAnalyse               String?
  typeEcart                      String?
  cause                          String?
  resultatAttendu                String?
  resultatObtenu                 String?
  description                    String?
  expositionAccidentelle         Boolean?
  personneConcernee              String?
  fie                            Boolean?
  besoinNouvelleAnalyse          Boolean?
  pasNouvelleAnalyse             String?
  dateNouvelleAnalyse            DateTime?
  laboratoireNouvelleAnalyse     String?
  chantierNouvelleAnalyse        String?
  resultatAttenduNouvelleAnalyse String?
  resultatObtenuNouvelleAnalyse  String?
  statut                         StatutDossierEcart @default(OUVERT)
  dateCloture                    DateTime?
  evenementSSE                   Boolean            @default(false)
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  modifiePar                     String?
  modifieLe                      DateTime?
  archiveLe                      DateTime?
  fichesSSE                      FicheSSE[]
  actions                        Action[]
  rex                            Rex[]
}

// Une action est le plus souvent rattachée à un Écart, mais l'app d'origine
// permettait aussi d'en créer directement depuis une Fiche SSE ou un Écart
// amiante sans Écart associé (cas fréquent en pratique) — d'où les trois
// rattachements optionnels plutôt qu'un seul ecartId obligatoire.
model Action {
  id             String        @id @default(cuid())
  reference      String        @unique
  // Plusieurs écarts pour une seule action : une même correction couvre
  // souvent plusieurs constats (même cause, même chantier), et la dupliquer
  // obligerait à la clôturer plusieurs fois. Les trois autres rattachements
  // restent uniques, et un seul type de rattachement à la fois.
  ecarts         Ecart[]
  ficheSSE       FicheSSE?     @relation(fields: [ficheSSEId], references: [id])
  ficheSSEId     String?
  ecartAmiante   EcartAmiante? @relation(fields: [ecartAmianteId], references: [id])
  ecartAmianteId String?
  remontee       RemonteeInfo? @relation(fields: [remonteeId], references: [id])
  remonteeId     String?
  // Actions préventives d'un REX : elles vivent dans le plan d'action comme les
  // autres, et se rattachent au REX comme les autres à leur écart ou évènement.
  rex            Rex?          @relation(fields: [rexId], references: [id])
  rexId          String?
  reclamation    Reclamation?  @relation(fields: [reclamationId], references: [id])
  reclamationId  String?
  type           TypeAction
  action         String
  responsable    String
  echeance       DateTime?
  statut         StatutAction  @default(A_FAIRE)
  realiseeLe     DateTime?
  preuve         String?
  verifiePar     String?
  verifieLe      DateTime?
  origine        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  modifiePar     String?
  modifieLe      DateTime?
  archiveLe      DateTime?

  @@index([rexId])
  @@index([reclamationId])
}

// Plainte ou réclamation adressée par un client, un maître d'ouvrage, un
// riverain… Entité à part des écarts : un écart est une non-conformité que l'on
// constate, une réclamation est ce qu'un tiers nous reproche — elle appelle une
// réponse, et se suit dans ses propres indicateurs. Un même courrier soulève
// souvent plusieurs points : ils sont listés dans ReclamationPoint plutôt
// qu'éclatés en autant de fiches, pour que le courrier se traite et reçoive sa
// réponse d'un seul tenant.
model Reclamation {
  id                String             @id @default(cuid())
  reference         String             @unique
  type              TypeReclamation    @default(RECLAMATION)
  dateReception     DateTime
  // Qui se plaint. Texte libre, comme le chantier d'une remontée.
  emetteur          String
  canal             String?
  chantier          String?
  typeActivite      TypeActivite?
  objet             String
  description       String?
  domaines          String[]           @default([])
  theme             String[]           @default([])
  analyse           String?
  reponse           String?
  dateReponse       DateTime?
  statut            StatutReclamation  @default(OUVERTE)
  personneSaisie    String?
  // Le courrier ou le mail du plaignant : photo ou PDF en data URL, comme
  // l'enregistrement d'un dossier.
  enregistrement    String?
  enregistrementNom String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  modifiePar        String?
  modifieLe         DateTime?
  archiveLe         DateTime?
  points            ReclamationPoint[]
  actions           Action[]
  fichesSSE         FicheSSE[]
  rex               Rex[]
}

// Un point soulevé par la réclamation, évalué à part : un manquement de
// sécurité n'a pas la gravité d'une vidéo d'avancement manquante.
model ReclamationPoint {
  id            String      @id @default(cuid())
  reclamation   Reclamation @relation(fields: [reclamationId], references: [id], onDelete: Cascade)
  reclamationId String
  ordre         Int
  description   String
  gravite       String?
  frequence     String?
  criticite     String?
  cause         String?
  createdAt     DateTime    @default(now())

  @@index([reclamationId])
}

// Retour d'expérience MASE : capitalise un enseignement transverse, distinct du plan
// d'action existant qui reste scopé à un écart précis. Ses sources sont un mélange libre
// d'écarts, d'évènements SSE, d'écarts amiante et de remontées (un seul élément, ou
// plusieurs éléments récurrents), ou aucune (origine SPONTANE) pour un REX spontané /
// bonne pratique.
// `origine` est déduite du rattachement choisi à la création, jamais saisie
// indépendamment, pour ne jamais pouvoir contredire le rattachement réel. La diffusion
// se fait par groupes de rôles + canaux (destinatairesRoles / canaux), pas nominative :
// pas de preuve de lecture individuelle, seulement la preuve qu'elle a été programmée.
model Rex {
  id                         String         @id @default(cuid())
  reference                  String         @unique
  titre                      String
  origine                    OrigineREX
  // Rempli seulement si origine = EVENEMENT_SSE. Texte libre (comme typeEvenement sur
  // FicheSSE), pas un enum : ce genre de taxonomie évolue, un enum Postgres impose une
  // migration à chaque ajout de valeur (vécu cette session avec les catégories de
  // RemonteeInfo).
  sousTypeSSE                String?
  nature                     NatureREX
  // Description propre à la nature : la bonne pratique elle-même (nature
  // BONNE_PRATIQUE) ou la pratique observée à ne pas reproduire (nature
  // PRATIQUE_A_EVITER). Sans rapport avec `causeRacine`/`enseignementsTires`
  // ci-dessous, qui existent indépendamment de la nature choisie.
  pratiqueDescription        String?
  // "Facteurs communs identifiés" (mode plusieurs éléments récurrents) ou
  // "Cause racine" (mode élément unique) : même champ, intitulé différent
  // selon le mode choisi à la création.
  causeRacine                String?
  // Coché parmi une liste suggérée (mode plusieurs éléments récurrents
  // uniquement) : cf. RemonteeInfo.categories pour le choix texte libre + suggestions
  // plutôt qu'un enum.
  pointsCommuns              String[]       @default([])
  enseignementsTires         String?
  raisonDiffusion            String?
  themes                     String[]       @default([])
  destinatairesRoles         String[]       @default([])
  canaux                     String[]       @default([])
  noteInterne                String?
  // Un REX en brouillon n'a pas encore été publié : il n'est pas compté dans
  // les indicateurs de diffusion tant qu'il reste à cet état.
  brouillon                  Boolean        @default(false)
  statut                     StatutREX      @default(REDIGE)
  dateDiffusion              DateTime?
  dateDiffusionPlanifiee     DateTime?
  dateVerificationEfficacite DateTime?
  ecarts                     Ecart[]
  fichesSSE                  FicheSSE[]
  ecartsAmiante              EcartAmiante[]
  remontees                  RemonteeInfo[]
  reclamations               Reclamation[]
  // Les actions préventives du REX sont des actions du plan d'action.
  actions                    Action[]
  // Fiche de diffusion apportée par l'utilisateur (document externe), à la place ou en
  // plus de la fiche générée par l'application.
  ficheExterne               RexDocument?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  modifiePar                 String?
  modifieLe                  DateTime?
  archiveLe                  DateTime?
}

// Fiche de diffusion déposée par l'utilisateur : un document externe (PDF, Word,
// PowerPoint, Excel, image). Table à part de Rex : le contenu pèse plusieurs
// mégaoctets et ne doit jamais être relu avec la liste ou la fiche du REX — il n'est
// lu que pour servir le fichier (route /rex/[id]/fiche-externe). Un seul document par
// REX : en déposer un second remplace le premier.
model RexDocument {
  id        String   @id @default(cuid())
  rex       Rex      @relation(fields: [rexId], references: [id], onDelete: Cascade)
  rexId     String   @unique
  nom       String
  type      String
  taille    Int
  contenu   Bytes
  ajoutePar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Plan d'action du Document Unique. Table autonome plutôt qu'un rattachement
// de plus sur Action : ses colonnes sont celles du DU — risques concernés,
// action permanente ou ponctuelle, preuve de réalisation — et n'ont presque
// rien de commun avec celles d'une action corrective d'écart. Les mêler
// obligerait à porter les deux jeux de colonnes dans une seule table, à moitié
// vides des deux côtés.
model ActionDU {
  id                String    @id @default(cuid())
  // PA1, PA2… : la numérotation du document lui-même, à laquelle les fiches de
  // risques du DU renvoient. Stockée en entier pour que PA10 se classe après
  // PA9 et non entre PA1 et PA2, comme le ferait un tri sur du texte.
  numero            Int       @unique
  action            String
  // Texte libre : le DU écrit des plages ("E3 à E15", "F9 à F13") et des
  // listes mêlées, qu'une sélection de risques cochés ne saurait pas rendre.
  risquesConcernes  String?
  typeAction        String?
  // Une fonction (Direction, Encadrement…) et non une personne nommée : c'est
  // ainsi que le DU désigne les responsables.
  responsable       String?
  // Plusieurs moyens de preuve par action, saisis un par ligne.
  preuveRealisation String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  modifiePar        String?
  modifieLe         DateTime?
  archiveLe         DateTime?
}
