# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# captures de vérification locale (non versionnées)
/screenshots

# Données réelles importées depuis le classeur Excel : chantiers et noms de
# collaborateurs. Déposé le temps de l'import, jamais versionné.
prisma/import-data/*.json

# Documentation destinée aux assistants de code, déposée par les CLI (Prisma,
# Next.js). Sans rapport avec l'application, et ces dossiers font échouer la
# copie du dépôt sous Windows.
.agents/
.claude/
.windsurf/
skills-lock.json
AGENTS.md
CLAUDE.md

# Sauvegardes locales : données réelles, jamais dans le dépôt.
sauvegardes/
